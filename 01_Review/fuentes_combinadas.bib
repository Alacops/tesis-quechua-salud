@CONFERENCE{Chen202120,
	author = {Chen, William and Fazio, Brett},
	title = {Morphologically-Guided Segmentation For Translation of Agglutinative Low-Resource Languages},
	year = {2021},
	journal = {Proceedings of the 4th Workshop on Technologies for Machine Translation of Low-Resource Languages, LoResMT 2021},
