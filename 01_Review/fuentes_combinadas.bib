	note = {Cited by: 1; Conference name: 15th International Conference on Agents and Artificial Intelligence, ICAART 2023; Conference sponsors: ; Conference code: 301209; Conference date: 22 February 2023 through 24 February 2023; All Open Access; Gold Open Access}
}

