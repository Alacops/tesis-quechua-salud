@CONFERENCE{Zevallos20221,
	author = {Zevallos, Rodolfo and Ortega, John E. and Chen, William and Castro, Richard and Bel, Nuria and Yoshikawa, Cesar and Ventura, Renzo and Aradiel, Hilario and Melgarejo, Nelsi},
	title = {Introducing QuBERT: A Large Monolingual Corpus and BERT Model for Southern Quechua},
	year = {2022},
	journal = {DeepLo 2022 - 3rd Workshop on Deep Learning Approaches for Low-Resource NLP, Proceedings of the DeepLo Workshop},
	pages = {1 - 13},
	url = {https://www.scopus.com/pages/publications/85137584361?origin=resultslist},
	affiliations = {Universitat Pompeu Fabra, Spain; Universidade de Santiago de Compostela (CITIUS), Spain; University of Central Florida, United States; Universidad Nacional de San Antonio Abad, Peru; Universidad Nacional del Callao, Peru; Pontificia Universidad Católica del Perú, Peru},
	abstract = {The lack of resources for languages in the Americas has proven to be a problem for the creation of digital systems such as machine translation, search engines, chat bots, and more. The scarceness of digital resources for a language causes a higher impact on populations where the language is spoken by millions of people. We introduce the first official large combined corpus for deep learning of an indigenous South American low-resource language spoken by millions called Quechua. Specifically, our curated corpus is created from text gathered from the southern region of Peru where a dialect of Quechua is spoken that has not traditionally been used for digital systems as a target dialect in the past. In order to make our work repeatable by others, we also offer a public, pre-trained, BERT model called QuBERT which is the largest linguistic model ever trained for any Quechua type, not just the southern region dialect. We furthermore test our corpus and its corresponding BERT model on two major tasks: (1) named-entity recognition (NER) and (2) part-of-speech (POS) tagging by using state-of-the-art techniques where we achieve results comparable to other work on higher-resource languages. In this article, we describe the methodology, challenges, and results from the creation of QuBERT which is on on par with other state-of-the-art multilingual models for natural language processing achieving between 71 and 74% F1 score on NER and 84-87% on POS tasks. © 2022 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Deep learning; Learning algorithms; Natural language processing systems; Speech recognition; Chat bots; Digital resources; Digital system; High impact; Linguistic Modelling; Low resource languages; Machine translations; Named entity recognition; Part of speech tagging; Parts-of-speech tagging; Search engines},
	editor = {Cherry C. and Fan A. and Foster G. and Haffari G. and Khadivi S. and Peng N. and Ren X. and Shareghi E. and Swayamdipta S.},
	publisher = {Association for Computational Linguistics (ACL)},
	isbn = {978-195591797-1},
	language = {English},
	abbrev_source_title = {DeepLo - Workshop Deep Learn. Approaches Low-Resour. NLP, Proc. DeepLo Workshop},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 19; Conference name: 3rd Workshop on Deep Learning Approaches for Low-Resource NLP, DeepLo 2022; Conference sponsors: ebay; Google; Conference code: 182123; Conference date: 14 July 2022}
}

@ARTICLE{Ortega2020325,
	author = {Ortega, John E. and Castro Mamani, Richard and Cho, Kyunghyun},
	title = {Neural machine translation with a polysynthetic low resource language},
	year = {2020},
	journal = {Machine Translation},
	volume = {34},
