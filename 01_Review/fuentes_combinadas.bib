@CONFERENCE{Ortega202144,
	author = {Ortega, John E. and Mamani, Richard Alexander Castro and Samame, Jaime Rafael Montoya},
	title = {Love Thy Neighbor: Combining Two Neighboring Low-Resource Languages for Translation},
	year = {2021},
	journal = {Proceedings of the 4th Workshop on Technologies for Machine Translation of Low-Resource Languages, LoResMT 2021},
	pages = {44 - 51},
	url = {https://www.scopus.com/pages/publications/85127106811?origin=resultslist},
	affiliations = {New York University, New York, NY, United States; Universidad Nacional de San Antonio Abad, Cusco, Peru; Pontificia Universidad Católica del Perú, Lima, Peru},
	abstract = {Low-resource languages sometimes take on similar morphological and syntactic characteristics due to their geographic nearness and shared history. Two low-resource neighboring languages found in Peru, Quechua and Ashaninka, can be considered, at first glance, two languages that are morphologically similar. In order to translate the two languages, various approaches have been taken. For Quechua, neural machine transfer-learning has been used along with byte-pair encoding. For Ashaninka, the language of the two with fewer resources, a finite-state transducer is used to transform Ashaninka texts and its dialects for machine translation use. We evaluate and compare two approaches by attempting to use newly-formed Ashaninka corpora for neural machine translation. Our experiments show that combining the two neighboring languages, while similar in morphology, word sharing, and geographical location, improves Ashaninka-Spanish translation but degrades Quechua-Spanish translations. © 2021 Proceedings of the 4th Workshop on Technologies for Machine Translation of Low-Resource Languages, LoResMT 2021. All rights reserved.},
	keywords = {Computational linguistics; Neural machine translation; Byte-pair encoding; Finite state transducers; Geographical locations; Geographics; Low resource languages; Machine translations; Transfer learning; Computer aided language translation},
	editor = {Ortega J. and Ojha A.Kr. and Ojha A.Kr. and Kann K. and Liu C.-H.},
	publisher = {Association for Machine Translation in the Americas},
	language = {English},
	abbrev_source_title = {Proc. Workshop Technol. Mach. Transl. Low-Resour., Lang., LoResMT},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5; Conference name: 4th Workshop on Technologies for Machine Translation of Low-Resource Languages, LoResMT 2021; Conference sponsors: ; Conference code: 178706; Conference date: 16 August 2021 through 20 August 2021}
}

@CONFERENCE{Court20241332,
	author = {Court, Sara and Elsner, Micha},
	title = {Shortcomings of LLMs for Low-Resource Translation: Retrieval and Understanding are Both the Problem},
	year = {2024},
	journal = {Conference on Machine Translation -  Proceedings},
	volume = {2024-November},
	pages = {1332 - 1354},
	url = {https://www.scopus.com/pages/publications/85216119056?origin=resultslist},
	affiliations = {The Ohio State University, United States},
	abstract = {This work investigates the in-context learning abilities of pretrained large language models (LLMs) when instructed to translate text from a low-resource language into a high-resource language as part of an automated machine translation pipeline. We conduct a set of experiments translating Southern Quechua to Spanish and examine the informativity of various types of context retrieved from a constrained database of digitized pedagogical materials (dictionaries and grammar lessons) and parallel corpora. Using both automatic and human evaluation of model output, we conduct ablation studies that manipulate (1) context type (morpheme translations, grammar descriptions, and corpus examples), (2) retrieval methods (automated vs. manual), and (3) model type. Our results suggest that even relatively small LLMs are capable of utilizing prompt context for zero-shot low-resource translation when provided a minimally sufficient amount of relevant linguistic information. However, the variable effects of context type, retrieval method, model type, and language-specific factors highlight the limitations of using even the best LLMs as translation systems for the majority of the world’s 7,000+ languages and their speakers. ©2024 Association for Computational Linguistics.},
	keywords = {Adversarial machine learning; Computer aided language translation; Context free grammars; Context sensitive grammars; Contrastive Learning; Modeling languages; Zero-shot learning; Automated machines; Context learning; In contexts; Language model; Learning abilities; Low resource languages; Machine translations; Modeling type; Parallel corpora; Retrieval methods; Machine translation},
	editor = {Haddow B. and Kocmi T. and Koehn P. and Monz C.},
