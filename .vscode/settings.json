{
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "C:/Users/User/AppData/Local/Programs/MiKTeX/miktex/bin/x64/pdflatex.exe",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "biber",
      "command": "C:/Users/User/AppData/Local/Programs/MiKTeX/miktex/bin/x64/biber.exe",
      "args": [
        "%DOCFILE%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex -> biber -> pdflatex x2 (APA7)",
      "tools": ["pdflatex", "biber", "pdflatex", "pdflatex"]
    },
    {
      "name": "pdflatex (rapido, sin bibliografia)",
      "tools": ["pdflatex"]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux", "*.bbl", "*.bcf", "*.blg", "*.idx", "*.ind", "*.lof",
    "*.lot", "*.loa", "*.loe", "*.lanx", "*.out", "*.toc", "*.acn",
    "*.acr", "*.alg", "*.glg", "*.glo", "*.gls", "*.fls", "*.log",
    "*.fdb_latexmk", "*.snm", "*.synctex.gz", "*.nav", "*.run.xml"
  ]
}
